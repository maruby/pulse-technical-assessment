# Neon pooled URL for application traffic (the hostname contains `-pooler`).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/DATABASE?sslmode=require"

# Neon direct URL for Prisma migration commands. Do not use it for serverless app traffic.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Public Mapbox token. Restrict its URL origins and scopes in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_public_mapbox_token_here"
